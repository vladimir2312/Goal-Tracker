@model TelegrammMiniApp.Models.Goal

<h1>Новая цель</h1>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <div>
        <label>Название:</label>
        <input asp-for="Title" required />
    </div>

    <div>
        <label>Описание:</label>
        <textarea asp-for="Description"></textarea>
    </div>

    <div>
        <label>Цель (сколько нужно):</label>
        <input asp-for="TargetValue" type="number" step="any" required />
    </div>

    <div>
        <label>Текущий прогресс (сколько уже есть):</label>
        <input asp-for="CurrentValue" type="number" step="any" value="0" />
    </div>

    <div>
        <label>Единица (руб/книг/км):</label>
        <input asp-for="Unit" />
    </div>

    <button type="submit">Создать</button>
    <a href="/Goals">Отмена</a>
</form>