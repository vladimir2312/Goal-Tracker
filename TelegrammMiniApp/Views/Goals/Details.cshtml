@model TelegrammMiniApp.Models.Goal
@{
    ViewData["Title"] = Model.Title;
    var pct = Model.TargetValue > 0 ? (int)Math.Min(100, Model.CurrentValue / Model.TargetValue * 100) : 0;
}

<a href="/Goals" class="back-link">← Назад к целям</a>

<div class="detail-card animate-in">
    <h1>@Model.Title</h1>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="detail-desc">@Model.Description</p>
    }

    <div class="big-progress">
        <div class="big-progress-bar">
            <div class="big-progress-fill" style="width: @(pct)%;"></div>
        </div>
        <div class="big-progress-meta">
            <span>@Model.CurrentValue / @Model.TargetValue @Model.Unit</span>
            <span class="pct">@pct%</span>
        </div>
    </div>
</div>

<div class="action-panel">
    <h3>Обновить прогресс</h3>
    <form method="post" asp-action="AddProgress" asp-route-id="@Model.Id" class="inline-form">
        @Html.AntiForgeryToken()
        <input type="number" name="value" step="any" required placeholder="Введи новое значение" />
        <button type="submit" class="btn-primary">Обновить</button>
    </form>
</div>

<div class="action-panel danger-zone">
    <h3>Опасная зона</h3>
    <p>Это действие нельзя отменить. Прогресс будет потерян навсегда.</p>
    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Точно удалить цель?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-danger">Удалить цель</button>
    </form>
</div>